{
  "name": "@proofline/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": "./src/index.ts",
  "bin": {
    "proofline": "./dist/index.js"
  },
  "scripts": {
    "build": "../../node_modules/.bin/esbuild src/bin.ts --bundle --platform=node --format=esm --target=node22 --banner:js='#!/usr/bin/env node' --external:solc --external:undici --external:@ethereumjs/common --external:@ethereumjs/util --external:@ethereumjs/vm --outfile=dist/index.js"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@proofline/contracts": "0.1.0",
    "@proofline/domain": "0.1.0",
    "@proofline/fdc-coston2": "0.0.0",
    "viem": "^2.55.10"
  }
}
