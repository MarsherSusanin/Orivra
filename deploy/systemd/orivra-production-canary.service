[Unit]
Description=Orivra production pilot canary checkpoint
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/node /opt/orivra/current/scripts/resume-production-canary.mjs --state-root /var/lib/orivra/production-canary
ReadOnlyPaths=/opt/orivra/current /opt/orivra/evidence
ReadWritePaths=/var/lib/orivra/production-canary
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
