[Unit]
Description=Orivra encrypted Timeweb production full backup
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/node /opt/orivra/current/scripts/run-timeweb-daily-backup.mjs
ReadOnlyPaths=/opt/orivra/current /opt/orivra/secrets /opt/orivra/runtime.env
ReadWritePaths=/opt/orivra/evidence/recovery
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
