{
  "name": "proofline",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarsherSusanin/Orivra.git"
  },
  "homepage": "https://orivra.xyz",
  "bugs": {
    "url": "https://github.com/MarsherSusanin/Orivra/issues"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "build:mcp": "npm run build --workspace @proofline/mcp",
    "check:licenses": "node scripts/check-dependency-licenses.mjs --check",
    "check:open-source": "node scripts/check-dependency-licenses.mjs --check && node scripts/check-open-source-readiness.mjs",
    "test": "vitest run",
    "test:contracts": "vitest run packages/contracts/test",
    "test:core": "vitest run packages/domain/test",
    "test:core:coverage": "vitest run packages/contracts/test packages/domain/test --coverage --coverage.include='packages/contracts/src/**' --coverage.include='packages/domain/src/**' --coverage.thresholds.statements=100 --coverage.thresholds.branches=100 --coverage.thresholds.functions=100 --coverage.thresholds.lines=100",
    "test:integration": "vitest run packages/fdc-coston2/test apps/api/test apps/worker/test packages/cli/test packages/action/test",
    "test:postgres": "vitest run apps/api/test/postgres",
    "test:web": "vitest run src",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:live:coston2": "vitest run --config vitest.live.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:coverage:backend": "vitest run --config vitest.coverage.backend.config.ts",
    "test:coverage:worker": "vitest run --config vitest.coverage.worker.config.ts",
    "test:coverage:web": "vitest run --config vitest.coverage.web.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test:sites": "node --test tests/*.test.mjs",
    "test:solidity": "vitest run contracts/test",
    "test:docker:static": "node --test --test-concurrency=1 tests/deployment/*.contract.test.mjs",
    "docker:prefetch": "node scripts/docker-prefetch.mjs",
    "test:docker": "node scripts/docker-gate.mjs",
    "test:docker:runtime": "node scripts/docker-runtime-smoke.mjs",
    "test:docker:recovery": "node scripts/docker-recovery-gate.mjs",
    "test:docker:product": "node scripts/mlp-product-compose.mjs",
    "release:freeze": "node scripts/release-freeze.mjs",
    "release:candidate": "node scripts/mlp-candidate-freeze.mjs",
    "release:publish": "node scripts/ghcr-publication.mjs",
    "test:action:artifact": "vitest run tests/action-artifact-sync.contract.test.ts --reporter=verbose",
    "compose:production": "node scripts/compose-production.mjs",
    "production:canary:resume": "node scripts/resume-production-canary.mjs --state-root /var/lib/orivra/production-canary",
    "production:demo:import": "node scripts/import-production-canonical-url-demo.mjs",
    "production:backup:daily": "node scripts/run-timeweb-daily-backup.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@ethereumjs/common": "10.1.2",
    "@ethereumjs/util": "10.1.2",
    "@ethereumjs/vm": "10.1.2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.10.3",
    "fast-check": "^4.5.3",
    "happy-dom": "^20.11.1",
    "pg": "^8.22.0",
    "playwright-core": "^1.62.1",
    "solc": "^0.8.36",
    "testcontainers": "^11.14.0",
    "typescript": "^7.0.2",
    "undici": "^7.29.0",
    "vitest": "^4.1.10"
  }
}
